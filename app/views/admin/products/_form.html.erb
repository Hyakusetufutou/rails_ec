<%= render partial: 'shared/error_messages', locals: { model: f.object} %>
<div class="mb-3 mx-5">
<%= f.label t('form.Product_name'), class: 'form-label' %>
<%= f.text_field :name, class: 'form-control' %>
</div>
<div class="mb-3 mx-5">
<%= f.label t('form.Price'), class: 'form-label' %>
<%= f.number_field :price, class: 'form-control' %>
</div>
<div class="mb-3 mx-5">
<%= f.label t('form.Description'), class: 'form-label' %>
<%= f.text_area :description, class: 'form-control' %>
</div>
<div class="mb-3 mx-5">
<%= f.label t('form.Image'), class: 'form-label' %>
<%= f.file_field :image, class: 'form-control' %>
</div>