    <div class="container">
      <main>
        <div class="py-5 text-center">
          <%= image_tag 'bootstrap-logo.svg', class: 'd-block mx-auto mb-4', alt: '', width: '72', height: '57' %>
          <h2><%= t 'index.Checkout_form' %></h2>
        </div>
        <%= render 'shared/flash_messages' %>
        <div class="row g-5">
          <div class="col-md-5 col-lg-4 order-md-last">
            <h4 class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-primary"><%= t 'index.Your_cart' %></span>
              <span class="badge bg-primary rounded-pill">
                <%= @total_item %>
              </span>
            </h4>
            <ul class="list-group mb-3">
              <% if @cart_items.present? %>
                <% @cart_items.each do |cart_item| %>
                  <li class="list-group-item d-flex justify-content-between lh-sm">
                    <div>
                      <h6 class="my-0"><%= "#{cart_item.product_name} ✖️ #{cart_item.quantity}" %></h6>
                      <div><small class="text-body-secondary"><%= cart_item.product_description %></small></div>
                      <%= link_to cart_item_path(cart_item.id, params: {item_action: 'decrease'}), data: {turbo_method: :patch}, style: 'text-decoration: none;' do %>
                        <button type="button" class="btn">
                          <i class="bi bi-dash-lg"></i>
                        </button>
                      <% end %>
                      <span class="border" style="padding: 0.5rem;"><%= cart_item.quantity %></span>
                      <%= link_to cart_item_path(cart_item.id, params: {item_action: 'increase'}), data: {turbo_method: :patch}, style: 'text-decoration: none;' do %>
                        <button type="button" class="btn">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                      <% end %>
                      <%= link_to cart_item_path(cart_item.id), data: {turbo_method: :delete, turbo_confirm: "#{cart_item.product_name}を削除します。よろしいでしょうか？"} do %>
                        <button type="button" class="btn btn-outline-secondary btn-sm">
                          <i class="bi bi-trash3"></i>
                        </button>
                      <% end %>
                    </div>
                    <span class="text-body-secondary"><%= "¥#{cart_item.total_price}" %></span>
                  </li>
                <% end %>
                <% if @cart.promotion_code_id %>
                  <%= "割引額：¥#{@cart.total_price - @cart.billing_amount}" %>
                <% end %>
                <%= "合計金額：¥#{@cart.billing_amount}" %>
              <% else %>
                <%= 'アイテムはありません' %>
              <% end %>
            </ul>
            <%= form_with model: @cart, url: cart_path(@cart.id), data: {turbo_method: :patch}, class: 'card p-2' do |f| %>
              <div class="input-group">
                <%= f.text_field :promotion_code, placeholder: 'Promo code', value: '', class: 'form-control' %>
                <% if @cart_items.present? %>
                  <%= f.submit t('index.Redeem'), class: 'btn btn-secondary' %>
                <% else %>
                  <%= f.submit t('index.Redeem'), class: 'btn btn-secondary', disabled: true %>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="col-md-7 col-lg-8">
            <%= form_with model: @order, url: orders_path, class: 'needs-validation' do |f| %>
              <%= render partial: 'shared/error_messages', locals: { model: f.object} %>
              <h4 class="mb-3"><%= t 'index.Billing_address' %></h4>
              <div class="row g-3">
                <div class="col-sm-6">
                  <%= f.label :firstname, t('index.First_name'), class: 'form-label' %>
                  <%= f.text_field :firstname, placeholder: '', value: '', required: true, class: 'form-control' %>
                  <div class="invalid-feedback">
                    Valid first name is required.
                  </div>
                </div>
                <div class="col-sm-6">
                  <%= f.label :lastname, t('index.Last_name'), class: 'form-label' %>
                  <%= f.text_field :lastname, placeholder: '', value: '', required: true, class: 'form-control' %>
                  <div class="invalid-feedback">
                    Valid last name is required.
                  </div>
                </div>
                <div class="col-12">
                  <%= f.label :username, t('index.User_name'), class: 'form-label' %>
                  <div class="input-group has-validation">
                    <span class="input-group-text">@</span>
                    <%= f.text_field :username, placeholder: 'Username', required: true, class: 'form-control' %>
                    <div class="invalid-feedback">
                      Your username is required.
                    </div>
                  </div>
                </div>
                <div class="col-12">
                  <%= f.label :email, t('index.Email'), class: 'form-label' %>
                  <%= f.email_field :email, placeholder: 'you@example.com', class: 'form-control' %>
                  <div class="invalid-feedback">
                    Please enter a valid email address for shipping updates.
                  </div>
                </div>
                <div class="col-12">
                  <%= f.label :address, t('index.Address'), class: 'form-label' %>
                  <%= f.text_field :address, placeholder: '1234 Main St', required: true, class: 'form-control' %>
                  <div class="invalid-feedback">
                    Please enter your shipping address.
                  </div>
                </div>
                <div class="col-12">
                  <%= f.label :address2, t('index.Address2'), class: 'form-label' %>
                  <%= f.text_field :address2, placeholder: 'Apartment or suite', class: 'form-control' %>
                </div>
                <div class="col-md-5">
                  <%= f.label :country, t('index.Country'), class: 'form-label' %>
                  <%= f.select :country, [['日本', 'japan']], { prompt: '選択'}, {required: true, class: 'form-select'} %>
                  <div class="invalid-feedback">
                    Please select a valid country.
                  </div>
                </div>
                <div class="col-md-4">
                  <%= f.label :state, t('index.State'), class: 'form-label' %>
                  <%= f.select :state,
                   [ '北海道', '青森県',
                  '秋田県','岩手県','山形県',
                  '宮城県','福島県','茨城県',
                  '栃木県','群馬県','埼玉県',
                  '千葉県','東京都','神奈川県',
                  '山梨県','新潟県','長野県',
                  '富山県','石川県','福井県',
                  '静岡県','愛知県','岐阜県',
                  '三重県','滋賀県','京都府',
                  '大阪府','奈良県','和歌山県',
                  '兵庫県','岡山県','広島県',
                  '山口県','鳥取県','島根県',
                  '香川県','徳島県','高知県',
                  '愛媛県','福岡県','大分県',
                  '宮崎県','佐賀県','長崎県',
                  '熊本県','鹿児島県','沖縄県'],
                  {prompt: '選択' }, {required: true, class: 'form-select' } %>
                  <div class="invalid-feedback">
                    Please provide a valid state.
                  </div>
                </div>
                <div class="col-md-3">
                  <%= f.label :zip, t('index.Zip'), class: 'form-label' %>
                  <%= f.text_field :zip, placeholder: '', required: true, pattern: '\d{7}',placeholder: '例. 1234567', class: 'form-control' %>
                  <div class="invalid-feedback">
                    Zip code required.
                  </div>
                </div>
              </div>
              <hr class="my-4">
              <div class="row gy-3">
                <div class="col-md-6">
                  <%= f.label :cc_name, t('index.Name_on_card'), class: 'form-label' %>
                  <%= f.text_field :cc_name, placeholder: '例. TAROU YAMADA', required: true, pattern: '[A-Z]+[ ][A-Z]+', class: 'form-control' %>
                  <small class="text-body-secondary"><%= t 'index.Full_name_as_displayed_on_card' %></small>
                  <div class="invalid-feedback">
                    Name on card is required
                  </div>
                </div>
                <div class="col-md-6">
                  <%= f.label :cc_number, t('index.Credit_card_number'), class: 'form-label' %>
                  <%= f.text_field :cc_number, placeholder: '例. 1111222233334444', required: true, pattern: '\d{14,16}', class: 'form-control' %>
                  <div class="invalid-feedback">
                    Credit card number is required
                  </div>
                </div>
                <div class="col-md-3">
                  <%= f.label :cc_expiration, t('index.Expiration'), class: 'form-label' %>
                  <%= f.text_field :cc_expiration, placeholder: 'MM/YY', required: true, pattern: '\d{2}[\/]\d{2}', class: 'form-control' %>
                  <div class="invalid-feedback">
                    Expiration date required
                  </div>
                </div>
                <div class="col-md-3">
                  <%= f.label :cc_cvv, 'CVV', class: 'form-label' %>
                  <%= f.text_field :cc_cvv, placeholder: '例. 1234', required: true, pattern: '\d{3,4}', class: 'form-control' %>
                  <div class="invalid-feedback">
                    Security code required
                  </div>
                </div>
              </div>
              <hr class="my-4">
              <% if @cart_items.present? %>
                <%= f.button t('index.Continue_to_checkout'), class: 'w-100 btn btn-primary btn-lg' %>
              <% else %>
                <%= f.button t('index.Continue_to_checkout'), class: 'w-100 btn btn-primary btn-lg', disabled: true %>
              <% end %>
            <% end %>
          </div>
        </div>
      </main>
      <footer class="my-5 pt-5 text-body-secondary text-center text-small">
        <p class="mb-1">&copy; 2017–2023 Company Name</p>
        <ul class="list-inline">
          <li class="list-inline-item"><a href="#">Privacy</a></li>
          <li class="list-inline-item"><a href="#">Terms</a></li>
          <li class="list-inline-item"><a href="#">Support</a></li>
        </ul>
      </footer>
    </div>
    <script src="/docs/5.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <script src="checkout.js"></script></body>
</html>
