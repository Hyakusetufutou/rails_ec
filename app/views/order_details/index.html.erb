<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Shop Homepage - Start Bootstrap Template</title>
  </head>
  <body>
    <!-- Header-->
    <header class="bg-dark py-5">
      <div class="container px-4 px-lg-5 my-5">
        <div class="text-center text-white">
          <h1 class="display-4 fw-bolder">管理者用画面</h1>
        </div>
      </div>
    </header>
    <!-- Section-->
    <section class="py-5">
      <div class="container px-4 px-lg-5 mt-5">
        <%= render 'shared/flash_messages' %>
        <table class="table">
          <thead class="table-dark">
            <tr>
              <th scope="col">注文ID</th>
              <th scope="col">注文者</th>
              <th scope="col">商品名</th>
              <th scope="col">数量</th>
              <th scope="col">価格(合計額)</th>
              <th scope="col">詳細</th>
            </tr>
          </thead>
          <tbody>
            <% if @order_details%>
              <% @order_details.each do |order_detail| %>
                <tr>
                  <th scope="row"><%= order_detail.order.id %></th>
                  <td><%= order_detail.order.firstname %></td>
                  <td><%= order_detail.product.name %></td>
                  <td><%= order_detail.quantity %></td>
                  <td><%= "¥#{order_detail.price}" %></td>
                  <td><%= link_to '詳細', order_detail_path(order_detail.id), class: 'btn btn-primary' %></td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
        <%= paginate @order_details %>
        <!-- Footer-->
        <footer class="py-5 bg-dark">
          <%= render 'shared/footer' %>
        </footer>
        <!-- Bootstrap core JS-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <!-- Core theme JS-->
        <script src="js/scripts.js"></script>
      </body>
    </html>
